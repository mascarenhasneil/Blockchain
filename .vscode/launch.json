      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development",
        "REQUIRE_API_KEY": "false"
      }
    },
    {
      "name": "Jest: Current File",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["jest", "${relativeFile}", "--runInBand"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach to Node (9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Launch 3-node network",
      "configurations": [
        "API Node 1 (3001)",
        "API Node 2 (3002)",
        "API Node 3 (3003)"
      ]
    }
  ]
}
