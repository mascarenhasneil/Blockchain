{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Node 1 (3001)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dev/api.js",
      "args": ["3001", "http://localhost:3001"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development",
        "REQUIRE_API_KEY": "false"
      }
    },
    {
      "name": "API Node 2 (3002)",
